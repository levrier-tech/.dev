{
  "name": "Lévrier Tech",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  // Orchestrator devcontainer for the levrier-tech organization.
  //
  // Bind-mounts every sibling levrier-tech repo from the host (../<name>) into
  // /workspaces/<name>. Falls back to `gh repo clone` inside the container
  // if a sibling repo is missing on host (e.g. GitHub Codespaces).
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "mounts": [
    "source=${localWorkspaceFolder}/../.github,target=/workspaces/.github,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../brigid,target=/workspaces/brigid,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "LT_ORG": "levrier-tech",
    "LT_REPOS": ".github brigid",
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_LEVRIER_TECH}"
  },
  // GH_TOKEN: forwards a levrier-tech-scoped host token into the container so gh
  // and the GitHub VS Code extensions are authenticated out of the box.
  // Set on the host: export GH_TOKEN_FOR_LEVRIER_TECH=<token>
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_LEVRIER_TECH}"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    // ── helpers4 features ─────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/dotfiles-sync:1": {},
    "ghcr.io/helpers4/devcontainer/shell-history-per-project:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    "ghcr.io/helpers4/devcontainer/peon-ping:1": {
      "packs": "peasant_fr,peon_fr,warcraft-peon"
    },
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck"
      ]
    }
  },
  "forwardPorts": [
    3000,
    5173,
    8080
  ],
  "portsAttributes": {
    "3000": {
      "label": "Dev server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "API server",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/setup-container.sh"
}
